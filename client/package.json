{
  "name": "@typeshift/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "clean:next": "node scripts/clean-next.mjs",
    "clean:worker": "node scripts/clean-worker.mjs",
    "prebuild": "npm run clean:next",
    "build": "next build",
    "prebuild:worker": "npm run clean:worker",
    "build:worker": "opennextjs-cloudflare build --config wrangler.jsonc",
    "predeploy:worker": "npm run clean:worker",
    "deploy:worker": "node ../scripts/ops-deploy.mjs --engine opennext --config wrangler.jsonc",
    "prepreview:worker": "npm run clean:worker",
    "preview:worker": "opennextjs-cloudflare build --config wrangler.jsonc && wrangler dev --config wrangler.jsonc",
    "start": "next start",
    "test": "node --require ../scripts/register-geteuid.cjs --import tsx --test \"src/**/*.test.ts\" && tsc -p tsconfig.json --noEmit",
    "preview": "next start",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --require ../scripts/register-geteuid.cjs --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\" && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^24.6.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
